# Backend HTTP server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=false
BACKEND_API_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
AUTO_START_MAIL_LISTENER=true
ORDERS_DB_PATH=orders.db
TEMPLATES_DB_PATH=templates.db
TEMPLATE_JPG_DIR=generated_template_jpgs
TEMPLATE_IMAGE_DPI=300
ORDER_PRINT_IMAGE_DPI=300
DEFAULT_TEMPLATE_ID=
TEMPLATE_IMAGE_RETRY_ATTEMPTS=3
TEMPLATE_IMAGE_RETRY_DELAY_SECONDS=5

# QQ IMAP
IMAP_HOST=imap.qq.com
IMAP_PORT=993
QQ_USER=your-account@qq.com
QQ_AUTH_CODE=your-qq-imap-authorization-code

# DeepSeek (reserved; currently disabled in the order parsing flow)
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60

# Google Apps Script
APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
WEBHOOK_TOKEN=your-webhook-token
GOOGLE_SHEETS_RETRY_INITIAL_SECONDS=30
GOOGLE_SHEETS_RETRY_MAX_SECONDS=900

# WeCom group robot
WECOM_ROBOT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-robot-key
WECOM_ROBOT_TIMEOUT_SECONDS=10
