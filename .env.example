# Backend HTTP server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=false
BACKEND_API_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
# Local development: false. Mail-listener server: true.
AUTO_START_MAIL_LISTENER=false
# MySQL database. DATABASE_URL overrides the individual MYSQL_* values.
DATABASE_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=dcjt
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT_SECONDS=5
MYSQL_CONNECT_RETRY_ATTEMPTS=5
MYSQL_CONNECT_RETRY_DELAY_SECONDS=0.5
MYSQL_POOL_SIZE=3
MYSQL_POOL_MAX_OVERFLOW=2
MYSQL_POOL_TIMEOUT_SECONDS=10
MYSQL_POOL_RECYCLE_SECONDS=600
MYSQL_POOL_PRE_PING=true
ORDER_FILES_DIR=generated_orders
TEMPLATE_IMAGE_DPI=300
IMAGE_MAP_RENDERER_ENABLED=true
IMAGE_MAP_RENDERER_TIMEOUT_SECONDS=120
IMAGE_MAP_RENDERER_BROWSER=
IMAGE_MAP_RENDERER_RECYCLE_AFTER=100
IMAGE_MAP_RENDERER_RETRY_ATTEMPTS=2
IMAGE_MAP_RESOURCE_RETRY_ATTEMPTS=3
IMAGE_MAP_RESOURCE_RETRY_DELAY_SECONDS=1
IMAGE_MAP_RESOURCE_CACHE_MAX_BYTES=67108864
IMAGE_MAP_RENDERER_MAX_PENDING=4
IMAGE_MAP_RENDERER_MAX_OUTPUT_PIXELS=50000000
# Keep Chromium sandbox enabled; set true only for a root container.
IMAGE_MAP_RENDERER_NO_SANDBOX=false
ORDER_PRINT_IMAGE_DPI=300
WECOM_ORDER_INFO_IMAGE_DIR=generated_orders
TEMPLATE_IMPORT_DIR=generated_template_imports
FONT_LAYOUT_PREVIEW_DIR=generated_font_layout_previews
TEMPLATE_IMPORT_MAX_BYTES=52428800
TESSERACT_COMMAND=tesseract
TEMPLATE_OCR_LANGUAGES=eng+chi_sim
DEFAULT_TEMPLATE_ID=
TEMPLATE_IMAGE_RETRY_ATTEMPTS=3
TEMPLATE_IMAGE_RETRY_DELAY_SECONDS=5

# QQ IMAP
IMAP_HOST=imap.qq.com
IMAP_PORT=993
QQ_USER=your-account@qq.com
QQ_AUTH_CODE=your-qq-imap-authorization-code

# DeepSeek（订单商品信息和字体布局规则解析、A4 翻译/留言识别）
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60

# WeCom group robot
WECOM_ROBOT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-robot-key
WECOM_ROBOT_TIMEOUT_SECONDS=10

# Aliyun OSS
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=fakestar-oss
OSS_REGION=oss-us-west-1
OSS_ENDPOINT=fakestar-oss.oss-us-west-1.aliyuncs.com
OSS_OBJECT_PREFIX=
OSS_ENDPOINT_IS_CNAME=false
